{
  "name": "craftstudio-lite",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.js",
    "check:sync": "node check-sync.mjs",
    "format": "prettier --write \"src/**/*.{js,css,html}\" \"tests/**/*.js\" \"../local-engine/*.mjs\" \"*.mjs\" package.json",
    "format:check": "prettier --check \"src/**/*.{js,css,html}\" \"tests/**/*.js\" \"../local-engine/*.mjs\" \"*.mjs\" package.json"
  },
  "dependencies": {
    "fflate": "0.8.2"
  },
  "devDependencies": {
    "esbuild": "0.24.2",
    "fake-indexeddb": "6.0.0",
    "prettier": "3.9.9"
  }
}
